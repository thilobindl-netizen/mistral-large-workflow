{
  "schemaVersion": 2,
  "kind": "app",
  "name": "mistral-large-workflow",
  "modules": [
    {
      "type": "app",
      "name": "worker",
      "path": "apps/worker",
      "routes": [],
      "port": null,
      "serve": "worker",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.worker"
      },
      "platform": "workflows",
      "dev": {
        "startCommand": "bash ../../tools/uv.sh run --all-packages python -m worker.entrypoints.dev"
      }
    }
  ]
}
